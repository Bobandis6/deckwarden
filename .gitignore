# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code session files (commit settings.json if it appears)
.claude/*
!.claude/settings.json

# raw Topdeck API responses (ingest writes, workflow archives to R2)
.topdeck-raw/

# One Piece image-mirror manifest (optcg-image-manifest.ts writes, mirror script reads)
.optcg-images/

# scratch tsx scripts for Claude sessions (must live inside the repo to resolve node_modules)
scripts/.tmp/
