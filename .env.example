# Neon pooled connection string (Dashboard → Connect → "Pooled connection", Node.js).
# Locally: copy to .env.local. On Vercel: Project → Settings → Environment Variables.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional: direct (non-pooler) URL for ingest scripts (temp tables + advisory locks
# need a real session). If unset, ingest derives it by stripping "-pooler" from DATABASE_URL.
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Sentry (P1.8) — error monitoring activates only when set (DSNs are safe to be
# public; the client one is inlined at build time). Sentry: Project → Settings →
# Client Keys (DSN). Set both to the same DSN in Vercel env vars.
# NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
