# Neon pooled connection string (Dashboard → Connect → "Pooled connection", Node.js).
# A local .env.local points at a DEVELOPMENT BRANCH of the Neon project, never at
# the production database: Neon console → Branches → create a branch from the
# default branch (main) → Connect → copy the branch's pooled connection string
# here. The production string belongs in Vercel (Project → Settings → Environment
# Variables, the Production environment) and in the GitHub Actions secrets, and
# nowhere else: `pnpm dev`, every `pnpm smoke:*`, `pnpm search:canned`, the
# ingest scripts and every scratch script read this file (S9,
# SECURITY-AUDIT-report.md L19; CLAUDE.md "Hard rules").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional: direct (non-pooler) URL for ingest scripts (temp tables + advisory locks
# need a real session). If unset, ingest derives it by stripping "-pooler" from DATABASE_URL.
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# The production compute's endpoint id — the first label of its host up to `-pooler`
# (`ep-xxx` for `ep-xxx-pooler.c-2.REGION.aws.neon.tech`; an identifier, not a secret) —
# kept in .env.local beside the branch's DATABASE_URL so that a pasted production string
# is refused by every `pnpm smoke:*` script and `pnpm counters:reset` before their first
# query (scripts/smoke/db.ts; SMOKE_ALLOW_REMOTE=1 is the per-run exception; LATER row
# 295). Unset: the check is off and the scripts say so on stderr. The nightly never sets it.
# PRODUCTION_DB_ENDPOINT="ep-xxx"

# Sentry (P1.8) — error monitoring activates only when set (DSNs are safe to be
# public; the client one is inlined at build time). Sentry: Project → Settings →
# Client Keys (DSN). Set both to the same DSN in Vercel env vars.
# NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

# --- Auth (P2.1, Better Auth: Discord + Google only) ---
# All five required in every environment that builds or serves the app.
# Cookie/token signing secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="..."
# Canonical origin for OAuth redirects. Optional: defaults to
# https://deckwarden.gg in production and http://localhost:3000 in dev.
# BETTER_AUTH_URL="http://localhost:3000"
# Discord app (discord.com/developers → your app → OAuth2). Register BOTH
# redirect URIs there:
#   http://localhost:3000/api/auth/callback/discord
#   https://deckwarden.gg/api/auth/callback/discord
DISCORD_CLIENT_ID="..."
DISCORD_CLIENT_SECRET="..."
# Google OAuth client (console.cloud.google.com → APIs & Services →
# Credentials → OAuth client, type "Web application"). Redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://deckwarden.gg/api/auth/callback/google
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."

# --- One Piece image serving (P4.1) ---
# Public R2 bucket base for OP card images. NOT a secret (it's in every card
# page's img src) but load-bearing for LOCAL punk-records runs: if unset, the
# ingest re-points every image_override at Bandai URLs, which browsers refuse
# to embed (CORP same-site) — OP images go blank until the next nightly with
# the Actions secret heals them. Copy the live value from any OP card page.
R2_PUBLIC_IMAGE_BASE="https://pub-xxx.r2.dev"

# --- Topdeck.gg ingest (P3.5) ---
# Self-serve API key (topdeck.gg account -> API; docs at topdeck.gg/docs/tournaments-v2).
# Owner action to mint. Absent = the topdeck ingest skips loudly (dormant), never fakes data.
# Also required as a GitHub Actions secret for the nightly ingest.
TOPDECK_API_KEY="..."

# --- Buy links (W7) ---
# TCGplayer affiliate wrapper base (Impact "?u=" style: the target URL gets
# appended encodeURIComponent-ed). MUST STAY EMPTY in every Vercel env —
# Hobby is a non-commercial plan and affiliate links are commercial use; the
# switch-on day belongs to the VPS/Pro move (LATER "Affiliate buy links").
# Unset (the norm): buy links are plain URLs, no rel="sponsored", and no
# disclosure line renders anywhere. Set: links wrap through it, gain
# rel="sponsored", and disclosures render in the buy menus, the site footer
# and /legal. Build-time inlined (NEXT_PUBLIC) — changing it means a redeploy.
# NEXT_PUBLIC_TCGPLAYER_PARTNER_BASE="https://partner.tcgplayer.com/c/XXXX/YYYY/21018?u="

# --- Limitless ingest (P4.5) ---
# OPTIONAL. The tournament endpoints are keyless (verified 2026-09-05); a key
# only buys rate headroom (+ the /games deck-rules endpoint, unused here).
# When granted (requested 2026-09-05): add here, `gh secret set
# LIMITLESS_API_KEY`, done — the script sends it as X-Access-Key with zero
# other behavior change. Absent/empty = keyless, never a skip.
# LIMITLESS_API_KEY="..."

# --- Switches read by code, documented in S8 (SECURITY-AUDIT-report.md I7) ---
# None is needed to run the site; each is read by one script or one module and
# is listed so that `grep process.env` and this file agree. Values are examples.
# Canonical origin for every absolute URL the crawlers see (sitemap, robots,
# canonical, OG) AND Better Auth's fallback origin when BETTER_AUTH_URL is unset
# (src/lib/seo/site.ts, src/lib/auth.ts). Unset: https://deckwarden.gg in
# production, http://localhost:3000 in dev; Vercel previews self-reference.
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Dev-only statement log: one line per Postgres statement (src/db/index.ts).
# DB_LOG=1
# Target of every `pnpm smoke:*` script and `pnpm search:canned`, default the local
# dev server. scripts/smoke/guard.ts refuses any host but localhost, 127.0.0.1 and
# [::1] before the first request (S9, SECURITY-AUDIT-report.md L19).
# BASE_URL="http://localhost:3000"
# The per-run opt-in for a deliberate remote smoke run: set it on the command line
# for that one run, never in this file; only the exact value 1 counts.
# SMOKE_ALLOW_REMOTE=1
# `pnpm decks:purge` deletes stale anonymous decks only when "true"; the nightly
# passes the PURGE_ANON_DECKS_APPLY repository variable here. Unset = dry run.
# PURGE_APPLY=true
# `pnpm decks:purge` prints one line per candidate (ids and names) — a local
# eyeballing run only, never the workflow (its log is world-readable).
# PURGE_VERBOSE=1
# `pnpm ingest:precons` re-fetches every MTGJSON precon file ("true"), or never
# ("false"); unset = the Sunday-UTC full sweep, new codes only on other nights.
# PRECONS_FULL=true
# `pnpm ingest:topdeck` / `pnpm ingest:limitless`: fetch this many days back
# instead of "since the last successful run" (a backfill or a re-run).
# TOPDECK_WINDOW_DAYS=30
# LIMITLESS_WINDOW_DAYS=30
# `pnpm ingest:punk-records`: pin the upstream commit (a rollback) and force a
# re-ingest at an unchanged sha (after a mapper fix).
# PUNK_RECORDS_SHA="0123456789abcdef0123456789abcdef01234567"
# PUNK_FORCE=1
# `pnpm backups:prune` lists what it would delete and deletes nothing — a local
# flag the workflow never sets. The four R2_* values are the nightly's secrets
# for the backup bucket (scripts/prune-backups.ts); never needed locally.
# BACKUP_PRUNE_DRY_RUN=1
# R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# R2_BUCKET="deckwarden-backups"
# R2_ACCESS_KEY_ID="..."
# R2_SECRET_ACCESS_KEY="..."
# Set by the platform, never by hand: NODE_ENV, VERCEL, VERCEL_ENV, VERCEL_URL,
# NEXT_PUBLIC_VERCEL_ENV (src/lib/seo/site.ts, src/instrumentation*.ts).
